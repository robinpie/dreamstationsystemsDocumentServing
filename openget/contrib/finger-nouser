# OpenGET item lookup over finger. Installed as /srv/finger/.nouser
#
#     finger abyssal_whip@dreamstation.systems
#     finger /W abyssal_whip@dreamstation.systems   (verbose)
#
# fingerd falls back to .nouser for any name with no file of its own; this
# treats that name as an item lookup instead, giving all 4,650 items a
# working finger address with nothing to generate. See openget.txt (RETRO
# FRONTENDS) for the fallback mechanism, the sandbox, and RFC 1288 CRLF.

use strict;
use warnings;

my $lib = $ENV{OPENGET_LIB} || '/usr/local/lib/openget/openget-fetch.pl';
do $lib or do {
    print "OpenGET is misconfigured on this host.\r\n";
    exit 0;
};

$| = 1;
# Raw bytes, NOT :encoding(UTF-8): HTTP::Tiny hands back undecoded UTF-8, so an encoding layer would re-encode each byte as Latin-1 and produce mojibake.
binmode(STDOUT, ':raw');

# fingerd forks a clean child with FINGER_USER, FINGER_VERBOSE and
# FINGER_CLIENT_IP set, and the name also in $ARGV[0].
my $user    = og_clean($ENV{FINGER_USER} // $ARGV[0] // '');
my $verbose = ($ENV{FINGER_VERBOSE} // '0') eq '1' ? 1 : 0;

if ($user eq '') {
    print "OpenGET - Old School RuneScape Grand Exchange prices\r\n";
    print "\r\n";
    print "Finger any item name to get its live price:\r\n";
    print "  finger abyssal_whip\@dreamstation.systems\r\n";
    print "  finger /W nature_rune\@dreamstation.systems   (full listing)\r\n";
    print "\r\n";
    print "Underscores stand in for spaces. Also on the web at\r\n";
    print "https://grandexchange.dreamstation.systems/\r\n";
    exit 0;
}

my $path = '/retro/text/item?q=' . og_escape($user);
$path .= '&verbose=1' if $verbose;

my ($body, $err) = og_fetch($path);

if (defined $err) {
    print "finger: OpenGET is not answering right now ($err).\r\n";
    print "The price archive keeps running; only this lookup is affected.\r\n";
    exit 0;
}

print $body;
