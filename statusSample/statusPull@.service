[Unit]
Description=Pull %i's host vitals for the status page
Documentation=file:/home/robin/configNotes/status.txt
After=network-online.target
Wants=network-online.target

# One instance per remote host: statusPull@starport, statusPull@thecomicshop.
# %i is validated again by the script (it becomes a path and a hostname).
# Separate instances, not one unit looping over hosts, so one dead box fails
# only its own unit and never delays the other's pull.

[Service]
Type=oneshot
User=statuspull
Group=statuspull
ExecStart=/usr/local/bin/statusPull.sh %i

# Never compete with chronyd. Same posture as statusSample.service.
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=30

# A SEPARATE UNIT from statusSample.service on purpose: that one runs as root
# with no network (AF_UNIX only). This one needs the network and so gets no
# root. ProtectHome is fine because the key lives in /var/lib/statuspull.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/run/status/%i
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
