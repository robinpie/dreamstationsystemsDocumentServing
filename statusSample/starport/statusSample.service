[Unit]
Description=Collect CPU, memory and disk figures for dreamstation's status page

[Service]
Type=oneshot
ExecStart=/usr/local/bin/statusSample.sh
Nice=10
IOSchedulingClass=idle

# /run/status via RuntimeDirectory rather than tmpfiles.d, so this unit is
# self-contained. Preserve=yes is LOAD-BEARING: this is a oneshot, and without
# it systemd deletes the directory every time the script exits, i.e. every
# 30 seconds, taking the CPU history with it.
RuntimeDirectory=status
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
StateDirectory=status
StateDirectoryMode=0755

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
