# dreamstation.systems — main site.
#
# nginx dispatches on the Host header, so each hostname gets its own server
# block. The wildcard *.dreamstation.systems means any unrecognized subdomain
# falls through to this block and gets the same content, rather than the
# 000-default-catchall's 444 — nginx still prefers more specific server blocks
# like pool.ntp.org's *.pool.ntp.org, so this only catches subdomains of
# dreamstation.systems itself.

# ------------------------------------------------------------ theme selection
#
# The /personal/ pages choose their stylesheet server-side. The location that
# uses these lives in snippets/theme.conf, which explains the whole design;
# only the maps are here, because `map` is valid in http context and a snippet
# included from inside a server block is not that.
#
# Read as one chain: $theme is the query parameter if it names a real theme,
# otherwise the cookie if that names a real theme, otherwise ubuntu804. Both
# maps list the themes explicitly, so an unknown id from either source can
# never reach the page — it lands on the default instead.
#
# TO ADD A THEME: drop themes/<id>.css, add <id> to BOTH maps, and add an
# <option> to the switcher on each themed page.
map $cookie_theme $theme_cookie {
    default   ubuntu804;
    gtk2      gtk2;
    motif     motif;
    skeuslop  skeuslop;
    ubuntu804 ubuntu804;
    plain     plain;
}

# Note the default: an absent or unrecognised ?theme= falls through to
# whatever the cookie map resolved to, rather than jumping straight to the
# default theme.
map $arg_theme $theme {
    default   $theme_cookie;
    gtk2      gtk2;
    motif     motif;
    skeuslop  skeuslop;
    ubuntu804 ubuntu804;
    plain     plain;
}

# ------------------------------------------------------------- theme-colour
#
# <meta name="theme-color"> for the themed pages, so the browser's own UI
# (Android's address bar, Safari's toolbars) is tinted to match whichever
# stylesheet nginx just selected, instead of a single value that is wrong for
# four themes out of five. The pages echo these with SSI exactly the way they
# echo $theme itself.
#
# Keyed on $theme, not on the cookie or the query parameter: $theme is the
# END of the precedence chain above, already normalised to a known id, so
# these two maps cannot disagree with the stylesheet that was actually
# served. `default` here is therefore unreachable in practice — it exists
# because a map needs one, and it carries ubuntu804's value so that even an
# impossible fallthrough matches the default theme.
#
# The values are quoted because an unquoted # opens a comment in nginx.conf,
# which would silently truncate every one of them to the empty string.
#
# Four of the five themes are fixed-appearance: they paint the same colours
# whatever the visitor's prefers-color-scheme is, so their light and dark
# entries are deliberately identical rather than accidentally unmaintained.
# Only `plain` — which is (almost) an empty stylesheet, i.e. browser defaults
# — actually follows the system, and it is the one theme whose two values
# differ. They match the pair on /professional/, which is the same situation:
# an unthemed page rendering in the browser's own colours.
#
# TO ADD A THEME: it needs an entry in these two maps as well as in the two
# above. A missing entry is not loud — it silently lands on the default's
# colour, which will merely look slightly wrong.
map $theme $theme_color_light {
    default   "#e8e8e0";
    gtk2      "#dcdad5";   # --gtk-bg,   window / widget grey
    motif     "#b0b0b0";   # --mtf-bg,   window / widget face
    skeuslop  "#e8eaef";   # --v-bg,     cool light grey-blue
    ubuntu804 "#e8e8e0";   # --panel-bg, the GNOME panel at the top
    plain     "#ffffff";
}

map $theme $theme_color_dark {
    default   "#e8e8e0";
    gtk2      "#dcdad5";
    motif     "#b0b0b0";
    skeuslop  "#e8eaef";
    ubuntu804 "#e8e8e0";
    plain     "#121212";
}

server {
    include snippets/clacks.conf;
    include snippets/accessLog.conf;
    listen 80;
    listen [::]:80;
    server_name dreamstation.systems www.dreamstation.systems mta-sts.dreamstation.systems *.dreamstation.systems;

    root /srv/http;
    index index.html;

    include snippets/statusCgi.conf;
    include snippets/pgpKey.conf;
    include snippets/theme.conf;
    include snippets/feeds.conf;
}

# HTTPS for the apex.
#
# This block is NOT new behaviour — https://dreamstation.systems/ already
# worked before it existed, but only by accident: the mta-sts block below was
# the sole :443 server for this domain, so it acted as the default server for
# any unmatched :443 request, and its certificate happens to carry
# dreamstation.systems as a SAN. That is a coincidence, not a configuration.
# Adding any :443 block that sorted earlier would have silently broken the
# apex, along with professional/index.html's declared https canonical.
#
# Same certificate, same content, same blast radius — just stated explicitly
# rather than inherited from block ordering.
#
# Port 80 above is deliberately NOT redirected here. This box's whole character
# is serving plain, old protocols (Gopher, Spartan, finger); forcing HTTPS on
# the one that predates them would be out of keeping, and nothing served here
# is sensitive.
server {
    include snippets/clacks.conf;
    include snippets/accessLog.conf;
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name dreamstation.systems www.dreamstation.systems;

    ssl_certificate     /etc/letsencrypt/live/dreamstation.systems/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dreamstation.systems/privkey.pem;

    root /srv/http;
    index index.html;

    include snippets/statusCgi.conf;
    include snippets/wkd.conf;
    include snippets/pgpKey.conf;
    include snippets/theme.conf;
    include snippets/feeds.conf;
}

# openpgpkey.dreamstation.systems — OpenPGP Web Key Directory, advanced method.
#
# GnuPG tries the advanced method FIRST and only falls back to the direct
# method (the apex's /.well-known/openpgpkey/hu/) if it fails. This name has
# always resolved, via the *.dreamstation.systems wildcard A record, and the
# apex :443 block above answered it by being the first :443 block in config
# order. But the certificate carried no SAN for it, so every advanced lookup
# died in the TLS handshake and fell back silently.
#
# The cert now covers this name, so both methods work and the fallback is a
# real backstop rather than the only path that ever succeeded.
server {
    include snippets/clacks.conf;
    include snippets/accessLog.conf;
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name openpgpkey.dreamstation.systems;

    ssl_certificate     /etc/letsencrypt/live/dreamstation.systems/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dreamstation.systems/privkey.pem;

    root /srv/http;

    include snippets/wkd.conf;

    # This vhost exists to serve exactly one tree. It shares a docroot with the
    # main site purely so one rsync deploy covers both, but nothing else here
    # should be reachable under this hostname — serving the whole site from a
    # second name would just be duplicate content on a name nobody browses.
    #
    # A regex location wins over this prefix location, so the WKD tree above is
    # unaffected.
    location / {
        return 404;
    }
}

# HTTPS is separately needed here for MTA-STS: senders' mail servers fetch
# https://mta-sts.dreamstation.systems/.well-known/mta-sts.txt to learn this
# domain requires TLS for inbound mail.
server {
    include snippets/clacks.conf;
    include snippets/accessLog.conf;
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name mta-sts.dreamstation.systems;

    ssl_certificate     /etc/letsencrypt/live/dreamstation.systems/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dreamstation.systems/privkey.pem;

    root /srv/http;
    index index.html;
}
