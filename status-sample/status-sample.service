[Unit]
Description=Collect CPU, disk and NTS-KE history for the status page
Documentation=file:/home/robin/configNotes/status.txt
After=chrony.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/status-sample.sh

# Never compete with chronyd, which is by far the busiest thing on this box.
# Same posture as disk-cleanup.service.
Nice=10
IOSchedulingClass=idle

# Hardening. ReadWritePaths=/run/chrony is LOAD-BEARING — see status.txt if
# NTS-KE figures ever read 0. AF_UNIX is required for the same reason: chronyc
# talks to chronyd over a unix socket. StateDirectory=status is the disk
# history's home (/var/lib/status).
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/run/status /run/chrony
StateDirectory=status
StateDirectoryMode=0755
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
