# modern-motherfucking-website.dreamstation.systems — a typo-catcher: 301s to
# modernmotherfuckingwebsite.dreamstation.systems (no hyphens), keeping the
# path and query. Serves no content.
#
# An EXACT server_name, so it beats the *.dreamstation.systems wildcard in
# dreamstation.systems; without this file the name still resolves (wildcard A
# record) and the apex answers it with the main site.
#
# Own certificate, for the same reason as modernmotherfuckingwebsite: the
# dreamstation.systems cert also covers mta-sts, so re-issuing it would put
# inbound mail's TLS in the blast radius of a web deploy. Without its own
# cert, https:// to this name would fail the handshake before any redirect.
#
# One server block on both ports (nothing to drift; both redirect to https).
#
# Enable only AFTER the certificate exists — nginx -t fails on a missing
# ssl_certificate. See nginx.txt.

server {
    include snippets/commonHeaders.conf;
    include snippets/dotEnv.conf;
    include snippets/accessLog.conf;
    listen 80;
    listen [::]:80;
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name modern-motherfucking-website.dreamstation.systems;

    ssl_certificate     /etc/letsencrypt/live/modern-motherfucking-website.dreamstation.systems/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/modern-motherfucking-website.dreamstation.systems/privkey.pem;

    # certbot's webroot is the apex's live docroot; promote protects
    # acme-challenge/.
    location /.well-known/acme-challenge/ {
        root /srv/http;
    }

    location / {
        return 301 https://modernmotherfuckingwebsite.dreamstation.systems$request_uri;
    }
}
